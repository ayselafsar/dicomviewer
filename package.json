{
  "name": "dicomviewer",
  "version": "2.3.3",
  "description": "Place this app in **nextcloud/apps/**",
  "scripts": {
    "prebuild": "rm -rf js && npm run build:viewer",
    "build:viewer": "cd acanio-viewer && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack pnpm install --frozen-lockfile && COREPACK_ENABLE_DOWNLOAD_PROMPT=0 corepack pnpm run build:nextcloud",
    "build": "webpack --node-env production --progress",
    "dev": "webpack --node-env development --progress",
    "watch": "webpack --node-env development --progress --watch",
    "lint": "eslint --ext .js,.vue src",
    "lint:fix": "eslint --ext .js,.vue src --fix",
    "stylelint": "stylelint src css",
    "stylelint:fix": "stylelint src css --fix"
  },
  "author": "Aysel Afsar",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/dialogs": "^8.0.0",
    "@nextcloud/files": "^4.1.1",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/logger": "^2.7.0",
    "@nextcloud/router": "^3.2.0",
    "@nextcloud/vue": "^9.14.1",
    "cornerstone-core": "^2.2.8",
    "cornerstone-math": "^0.1.7",
    "cornerstone-tools": "^2.4.0",
    "cornerstone-wado-image-loader": "^2.2.3",
    "dicom-parser": "^1.8.3",
    "hammerjs": "^2.0.8",
    "underscore": "^1.13.1",
    "vue": "^3.5.44"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/plugin-proposal-class-properties": "^7.13.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-modules-commonjs": "^7.13.8",
    "@babel/plugin-transform-shorthand-properties": "^7.12.13",
    "@babel/preset-env": "^7.13.12",
    "@nextcloud/babel-config": "^1.0.0",
    "@nextcloud/browserslist-config": "^3.0.0",
    "@nextcloud/eslint-config": "^8.3.0",
    "@nextcloud/eslint-plugin": "^2.2.1",
    "@nextcloud/stylelint-config": "^2.3.1",
    "@nextcloud/webpack-vue-config": "^7.1.0",
    "@vue/compiler-sfc": "^3.5.44",
    "@vue/eslint-config-typescript": "^13.0.0",
    "adm-zip": "^0.6.1",
    "axios": "^1.6.2",
    "babel-loader": "^10.0.0",
    "cli-progress": "^3.12.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^46.10.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.33.0",
    "minimizer-webpack-plugin": "^5.6.1",
    "node-polyfill-webpack-plugin": "4.0.0",
    "sass": "^1.64.2",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.4.4",
    "typescript": "^5.9.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.88.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^6.0.0"
  },
  "overrides": {
    "@nextcloud/vue": {
      "@nextcloud/l10n": "3.4.1"
    },
    "@nextcloud/dialogs": {
      "@nextcloud/l10n": "3.4.1"
    },
    "node-forge": "1.4.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    },
    "@nextcloud/eslint-plugin": {
      "fast-xml-parser": "5.11.2"
    }
  }
}
